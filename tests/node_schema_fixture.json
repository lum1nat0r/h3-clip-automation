                  ]
                }
              },
              "prefix": "ref_image_",
              "min": 0,
              "max": 9
            }
          }
        ],
        "ref_videos": [
          "COMFY_AUTOGROW_V3",
          {
            "template": {
              "input": {
                "required": {
                  "ref_video": [
                    "IMAGE",
                    {
                      "tooltip": "Reference video frames at 24 fps (2-15s)"
