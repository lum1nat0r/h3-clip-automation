          {
            "template": {
              "input": {
                "required": {
                  "ref_video_audio": [
                    "AUDIO",
                    {
                      "tooltip": "Soundtrack of the same-numbered reference video"
                    }
                  ]
                }
              },
              "prefix": "ref_video_audio_",
              "min": 0,
              "max": 3
            }
          }
        ],
        "ref_audios": [
          "COMFY_AUTOGROW_V3",
          {
            "template": {
              "input": {
                "required": {
                  "ref_audio": [
                    "AUDIO",
                    {
                      "tooltip": "Standalone reference audio"
                    }
                  ]
                }
              },
              "prefix": "ref_audio_",
              "min": 0,
              "max": 3
            }
          }
        ]
      }
    },
    "input_order": {
      "required": [
        "clip",
        "prompt",
        "width",
        "height",
        "length",
