# Copy to .env; this file contains no working credentials.
H3_AUTH_USER=h3
H3_AUTH_PASSWORD=
HF_TOKEN=
# A CUDA 13 capable NVIDIA driver (r580+) is required.
H3_GPU_ID=0
H3_RAM_LIMIT=32g
H3_IMAGE=h3-clip-automation:portable
H3_BIND_ADDRESS=127.0.0.1
H3_APP_PORT=18080
H3_COMFY_PORT=18081
H3_TLS_MODE=selfsigned
H3_TLS_HOST=localhost
